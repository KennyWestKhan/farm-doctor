# Claude Vision (get a key at https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Haiku is cheap/fast. For demo day / better accuracy use Sonnet:
VISION_MODEL=claude-sonnet-4-5-20250929
# VISION_MODEL=claude-haiku-4-5-20251001

# Demo day: set UNLIMITED_SCANS=true so judges aren't rate-limited
# UNLIMITED_SCANS=true
# SCAN_LIMIT=2

# Supabase (create a fresh project at https://supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AWS Textract for label OCR (IAM user with textract:DetectDocumentText)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PORT=3001
